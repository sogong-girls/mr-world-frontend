# 복사해서 .env.local로 쓰세요 (.env, *.local은 git에 올라가지 않음)

# 백엔드·AI 서버 주소. 비워 두면 같은 출처(/api, /api/ai)로 보낸다:
#   배포(Vercel)는 vercel.json rewrites, 개발(npm run dev)은 vite.config.js proxy가 서버로 넘겨 준다.
#   다른 출처로 직접 보내면 로그인 쿠키(SameSite=Lax)가 안 실릴 수 있으니 보통은 비워 둔다.
VITE_API_BASE_URL=
VITE_AI_BASE_URL=

# true면 서버 없이 src/mocks/data.js로 동작 (AI 채팅은 mock이 없어 AI 서버가 필요)
VITE_USE_MOCK=false

# 개발 서버 proxy 대상 (기본: 배포 서버). 로컬 서버를 쓸 때만 적는다.
# DEV_API_PROXY=http://localhost:8080
# DEV_AI_PROXY=http://localhost:8000
